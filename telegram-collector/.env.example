# Lấy API_ID và API_HASH tại https://my.telegram.org
TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_PHONE=+84xxxxxxxxx

# Đường dẫn file Excel (nếu chưa có thì tool sẽ tự tạo file mẫu với các cột chuẩn)
EXCEL_PATH=data.xlsx
EXCEL_SHEET_NAME=Messages

# Danh sách từ khóa lọc (cách nhau bằng dấu phẩy). Bỏ trống nếu muốn lấy tất cả tin nhắn.
# Ví dụ: mua,bán,cần tìm,tuyển dụng,báo giá
KEYWORDS=mua,bán,cần tìm,giá

# Danh sách ID hoặc Username nhóm cần theo dõi (cách nhau bằng dấu phẩy). Bỏ trống để theo dõi tất cả nhóm bạn tham gia.
# Ví dụ: @group1,@group2,-1001234567890
TARGET_GROUPS=
