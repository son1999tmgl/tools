{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "PostgreSQL": "Host=localhost;Port=5432;Database=trading_system;Username=postgres;Password=postgres"
  },
  "CollectorSettings": {
    "StorageDir": "data/storage",
    "StagingDir": "data/staging",
    "RunOnceImmediate": true,
    "PollIntervalSeconds": 3,
    "CollectAllSymbols": true,
    "MaxDegreeOfParallelism": 10,
    "PrioritySymbols": [
      "VN30F1M",
      "41I1GA000",
      "HPG",
      "FPT",
      "SSI",
      "TCB",
      "CACB2603"
    ]
  }
}
